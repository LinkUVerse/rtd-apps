# Keep the plan, task ledgers and written work logs in Git.
# Raw acceptance captures and historical input/source snapshots stay local.
/evidence/*
!/evidence/*.py
!/evidence/*.cjs
!/evidence/*.md
/workLog/*
!/workLog/*.md
!/workLog/current-data-lifecycle-progress.json

